menu title Debian Boot Options
timeout 100
default l0

label l0
        menu label Linux
        kernel /vmlinuz
        append initrd=/initrd.img earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=root=LABEL=root

label l0-recovery
        menu label Linux (recovery mode)
        kernel /vmlinuz
        append initrd=/initrd.img earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=root=LABEL=root single

label o0
        menu label Linux (previous)
        kernel /vmlinuz.old
        append initrd=/initrd.img.old earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=root=LABEL=root

label o0-recovery
        menu label Linux (previous, recovery mode)
        kernel /vmlinuz.old
        append initrd=/initrd.img.old earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=root=LABEL=root single

label n0
        menu label Linux NFS root
        kernel /vmlinuz
        append initrd=/initrd.img earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=/dev/nfs ip=:::::end0:dhcp nfsroot=@CONFIG_NFS_ROOT@,async,noatime,nodiratime,vers=4.2,ac,rsize=4096,wsize=4096 nfsrootdebug

label n0-recovery
        menu label Linux NFS root (recovery mode)
        kernel /vmlinuz
        append initrd=/initrd.img earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=/dev/nfs ip=:::::end0:dhcp nfsroot=@CONFIG_NFS_ROOT@,async,noatime,nodiratime,vers=4.2,ac,rsize=4096,wsize=4096 nfsrootdebug single

label O0
        menu label Linux NFS root (previous)
        kernel /vmlinuz.old
        append initrd=/initrd.img.old earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=/dev/nfs ip=:::::end0:dhcp nfsroot=@CONFIG_NFS_ROOT@,async,noatime,nodiratime,vers=4.2,ac,rsize=4096,wsize=4096 nfsrootdebug

label O0-recovery
        menu label Linux NFS root (previous, recovery mode)
        kernel /vmlinuz.old
        append initrd=/initrd.img.old earlyprintk rw rhgb rootwait rootfstype=ext4 LANG=en_US.UTF-8 net.ifnames=1 root=/dev/nfs ip=:::::end0:dhcp nfsroot=@CONFIG_NFS_ROOT@,async,noatime,nodiratime,vers=4.2,ac,rsize=4096,wsize=4096 nfsrootdebug single